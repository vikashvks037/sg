# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED: use a long random string in production (openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_change_this

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase Storage (S3 Protocol) ────────────────────────────────────────────
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_ACCESS_KEY=<your-s3-access-key>
SUPABASE_S3_SECRET_KEY=<your-s3-secret-key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_BUCKET=sg_media
